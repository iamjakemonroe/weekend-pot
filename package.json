{
  "name": "weekend-pot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev --port 8790",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply weekend-pot --local",
    "db:remote": "wrangler d1 migrations apply weekend-pot --remote",
    "deploy": "npm run build && wrangler d1 migrations apply weekend-pot --remote && wrangler deploy"
  },
  "dependencies": {
    "postgres": "3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "5.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251014.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.27",
    "postcss": "8.5.8",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "5.4.19",
    "vitest": "2.1.9",
    "wrangler": "4.40.0"
  }
}
